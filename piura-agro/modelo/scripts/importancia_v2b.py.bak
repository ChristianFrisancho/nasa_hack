"""Importancia de features: ablacion, permutacion, OAT y Sobol (SALib). Semilla fija. Uso: python scripts/importancia.py"""
import pathlib, sys
import numpy as np
import pandas as pd
sys.path.insert(0, str(pathlib.Path(__file__).parent))
import modelo as M
from SALib.sample import sobol as sobol_sample
from SALib.analyze import sobol

SEED = 42
N = 5000
OUT = M.BASE / "resultados"
FUENTE = {
    "mes_siembra": "NASA POWER diario 2000-2024 + FAO-56 Kc", "anio": "NASA POWER diario 2000-2024",
    "agua_riego_mm": "dotacion ANA PGRH por zona x fraccion por campaña supuesta 0.5-1.0",
    "eficiencia_riego": "eficiencia operativa ANA por zona; interpretacion (conduccion o total) supuesta",
    "agua_arroz_m3_ha": "ESCO arroz Piura 2024 (MIDAGRI) 10000-18000 m3/ha citando INIA 2020",
    "agua_extra_arroz_mm": "acotado por FAO Irrigation Water Needs (max) y consumo observado Agraria/DRA 2016 (min)",
    "pen_sanidad": "agentes compartidos de plagas_hospedantes_condiciones_v2.csv; magnitud supuesta",
    "ece_ds_m": "rango supuesto; umbrales FAO-56 T23", "taw_mm_m": "FAO-56 T19",
    "n_suelo_kg_ha": "rango supuesto", "p_suelo_kg_ha": "rango supuesto", "k_suelo_kg_ha": "rango supuesto",
    "credito_n_leguminosa": "FAO PNB16 T22 (max 60)", "precio_fert_n_pen_kg": "rango supuesto",
    "precio_fert_p_pen_kg": "rango supuesto", "precio_fert_k_pen_kg": "rango supuesto",
    "pendiente_pct": "umbral supuesto", "drenaje_malo": "umbral supuesto", "cultivo_previo": "familia botanica",
    "factor_costo": "ENA 2018 (piso), ESCO arroz 2024 (1.67x) y LATAM 2025 maiz (2.11x)", "factor_precio": "DRAP precio chacra, rango supuesto", "factor_rend": "DRAP rendimiento, rango supuesto",
}


def jacc(a, b):
    return np.array([len(x & y) / max(len(x | y), 1) for x, y in zip(a, b)])


def main():
    rng = np.random.default_rng(SEED)
    filas = []
    for zi, zona in enumerate(M.ZONAS):
        esc = M.muestrear(N, zi, rng)
        base = M.evaluar(esc)
        t1, t3, s = M.ranking(base)
        for f in M.FEATURES:
            # ablacion: fijar al valor central (lo que pasa si no pedimos el dato)
            e2 = esc.copy()
            e2[f] = int(np.median(M.ANIOS)) if f == "anio" else M.rango(f, zi)[1]
            a1, a3, s2 = M.ranking(M.evaluar(e2))
            filas.append(dict(feature=f, cultivo="todos", zona=zona, metodo="ablacion",
                              importancia=round(float(np.mean(np.abs(s2 - s)) / np.mean(np.abs(s)) * 100), 2),
                              cambio_top1_pct=round(float(np.mean(a1 != t1) * 100), 2),
                              cambio_top3_pct=round(float((1 - jacc(a3, t3).mean()) * 100), 2)))
            # permutacion
            e3 = esc.copy()
            e3[f] = rng.permutation(e3[f].values)
            p1, p3, s3 = M.ranking(M.evaluar(e3))
            filas.append(dict(feature=f, cultivo="todos", zona=zona, metodo="permutacion",
                              importancia=round(float(np.mean(np.abs(s3 - s)) / np.mean(np.abs(s)) * 100), 2),
                              cambio_top1_pct=round(float(np.mean(p1 != t1) * 100), 2),
                              cambio_top3_pct=round(float((1 - jacc(p3, t3).mean()) * 100), 2)))
        # OAT desde el escenario central, recorriendo cada mes de siembra
        for f in M.FEATURES:
            if f == "anio":
                vals = M.ANIOS
            else:
                lo, _, hi = M.rango(f, zi)
                vals = np.arange(int(lo), int(hi) + 1) if f in M.CATEG else np.linspace(lo, hi, 11)
            cambios, rangos_s = [], []
            for mes in range(1, 13):
                c = M.central(len(vals), zi)
                c["mes_siembra"] = mes
                c[f] = vals
                o1, _, os_ = M.ranking(M.evaluar(c))
                b1, _, _ = M.ranking(M.evaluar(M.central(1, zi).assign(mes_siembra=mes)))
                cambios.append(np.mean(o1 != b1[0]))
                rangos_s.append(os_.max() - os_.min())
            filas.append(dict(feature=f, cultivo="todos", zona=zona, metodo="OAT",
                              importancia=round(float(np.mean(rangos_s)), 0),
                              cambio_top1_pct=round(float(np.mean(cambios) * 100), 2), cambio_top3_pct=np.nan))
        # Sobol del margen por cultivo
        prob = {"num_vars": len(M.FEATURES), "names": M.FEATURES,
                "bounds": [[M.ANIOS[0], M.ANIOS[-1] + 0.999] if f == "anio" else
                           [M.rango(f, zi)[0], M.rango(f, zi)[2] + (0.999 if f in M.CATEG else 0)]
                           for f in M.FEATURES]}
        X = sobol_sample.sample(prob, 1024, calc_second_order=False, seed=SEED)
        e = pd.DataFrame(X, columns=M.FEATURES)
        for f in M.CATEG:
            e[f] = np.floor(e[f]).astype(int)
        e["zona"] = zi
        r = M.evaluar(e)
        for j, cult in enumerate(M.CROPS):
            Y = np.where(r["viable"][:, j], r["margen"][:, j], 0.0)
            if Y.std() == 0:
                continue
            Si = sobol.analyze(prob, Y, calc_second_order=False, seed=SEED)
            for f, st in zip(M.FEATURES, Si["ST"]):
                filas.append(dict(feature=f, cultivo=cult, zona=zona, metodo="sobol_ST",
                                  importancia=round(float(st), 4), cambio_top1_pct=np.nan, cambio_top3_pct=np.nan))
        # tasa de "ningun cultivo viable" y reparto del top1 en la base
        print(zona, "ninguno_viable_pct", round(float(np.mean(t1 == -1) * 100), 1),
              {M.CROPS[k] if k >= 0 else "ninguno": int(v) for k, v in zip(*np.unique(t1, return_counts=True))})
    df = pd.DataFrame(filas)
    hip = {"mes_siembra", "anio", "taw_mm_m", "cultivo_previo"}
    df["fuente_dato"] = df.feature.map(FUENTE)
    parcial = {"agua_riego_mm", "eficiencia_riego", "factor_costo", "agua_extra_arroz_mm", "agua_arroz_m3_ha"}
    df["estado"] = np.select([df.feature.isin(hip), df.feature.isin(parcial)], ["medido", "parcial_dato_zona_mas_hipotesis"], "hipotesis")
    df["notas"] = ("medido = el rango del feature tiene fuente; la importancia siempre es salida del modelo mecanico "
                   "FAO-56/FAO-33/Maas-Hoffman con N=%d escenarios por zona, semilla %d; no esta validada contra rendimiento por parcela" % (N, SEED))
    df.to_csv(OUT / "importancia_detalle.csv", index=False)
    return df


if __name__ == "__main__":
    main()
