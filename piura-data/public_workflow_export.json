      "id": "5bc30be4-20fa-4ed4-9852-212787fcde46",
      "name": "Puntos y periodo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        176
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const points = [\n {label:'Bajo Piura - referencia regional',lat:-5.42,lon:-80.74},\n {label:'Chira Sullana - referencia regional',lat:-4.90,lon:-80.69},\n {label:'San Lorenzo - referencia regional',lat:-4.85,lon:-80.25},\n {label:'Ayabaca - referencia regional',lat:-4.64,lon:-79.71},\n {label:'Huancabamba - referencia regional',lat:-5.24,lon:-79.45}\n];\nconst manual = ['manual','test'].includes($execution.mode);\nconst fmt = d => d.toISOString().slice(0,10).replace(/-/g,'');\nconst now = new Date();\nconst start = manual ? '20250101' : fmt(new Date(now.getTime()-35*86400000));\nconst end = manual ? '20251231' : fmt(new Date(now.getTime()-7*86400000));\nreturn points.map(p=>({json:{...p,start,end,period_kind:manual?'historico_2025':'ventana_reciente_con_latencia',url:'https://power.larc.nasa.gov/api/temporal/daily/point?parameters=T2M_MIN,T2M_MAX,T2M,PRECTOTCORR,ALLSKY_SFC_SW_DWN,RH2M,WS2M,PS&community=AG&longitude='+p.lon+'&latitude='+p.lat+'&start='+start+'&end='+end+'&format=JSON'}}));"
      }
    },
    {
      "id": "304b72b5-1030-4d14-9bd6-2cdd8b03b0e3",
      "name": "NASA POWER diario",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        496,
        176
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 120000,
          "batching": {
