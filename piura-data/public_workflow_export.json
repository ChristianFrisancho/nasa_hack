    {
      "id": "03174206-b4af-4ada-af48-cc833e1686c2",
      "name": "Normalizar documentos SENASA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        368
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows=[];const seen=new Set();\nconst text=s=>String(s||'').replace(/<script[\\s\\S]*?<\\/script>/gi,' ').replace(/<[^>]+>/g,' ').replace(/&nbsp;|&#160;/g,' ').replace(/&amp;/g,'&').replace(/\\s+/g,' ').trim();\nfor(const item of $input.all()){\n const docs=item.json.body;\n if(!Array.isArray(docs))throw new Error('SENASA no devolvio lista WordPress');\n for(const p of docs){\n  if(!p.id||!p.link)continue;if(seen.has(p.id))continue;seen.add(p.id);\n  const title=text(p.title?.rendered),content=text(p.content?.rendered);\n  const topics=[];for(const [topic,rx] of [['plagas',/plaga|mosca|fusarium|huanglongbing|nematod|picudo|langosta/i],['cultivos',/arroz|mango|banano|platano|limon|limón|maíz|maiz|uva|algodon|algodón|cacao|café|cafe/i],['sanidad_animal',/ántrax|antrax|aviar|ganado|porcin|vacunac/i]])if(rx.test(title+' '+content))topics.push(topic);\n  rows.push({json:{record_key:'senasa:'+p.id,record_type:'documento_oficial',topic:topics.join(',')||'contexto_regional',location_label:'Piura - mencion en archivo SENASA; verificar ambito exacto',source_url:p.link,source_date:p.date||'',retrieved_at:new Date().toISOString(),quality_status:'fuente_oficial_archivo_no_alerta_vigente',payload_json:JSON.stringify({title,content:content.slice(0,20000),modified:p.modified,tags:p.tags,categories:p.categories,screening_only:true})}});\n }\n}\nreturn rows;"
      }
    },
