    },
    {
      "id": "d8cb1d3f-d4a7-4c87-a25e-528fe5d131f2",
      "name": "Normalizar clima con unidades",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        176
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows=[];\nconst seed=$('Puntos y periodo').all();\nfor (let i=0;i<$input.all().length;i++) {\n const body=$input.all()[i].json;\n if (!body.properties?.parameter || !body.header) throw new Error('NASA POWER: respuesta sin parametros');\n const cfg=seed[i].json;\n const series=body.properties.parameter;\n const dates=Object.keys(series.T2M||{});\n if(!dates.length)throw new Error('NASA POWER sin dias');\n const fill=body.header.fill_value ?? -999;\n const units=Object.fromEntries(Object.entries(body.parameters||{}).map(([k,v])=>[k,v.units]));\n for(const d of dates){\n  const values={};const missing=[];\n  for(const [k,v] of Object.entries(series)){const x=v[d];values[k]=(x===fill||x===undefined)?null:x;if(values[k]===null)missing.push(k);}\n  rows.push({json:{record_key:'power:'+cfg.lat+':'+cfg.lon+':'+d,record_type:'clima_diario',topic:'clima_agua',location_label:cfg.label,source_url:cfg.url,source_date:d.slice(0,4)+'-'+d.slice(4,6)+'-'+d.slice(6,8),retrieved_at:new Date().toISOString(),quality_status:missing.length?'modelado_con_faltantes':'modelado_regional_no_medicion_parcela',payload_json:JSON.stringify({lat:cfg.lat,lon:cfg.lon,values,units,missing,period_kind:cfg.period_kind,source_header:body.header})}});\n }\n}\nreturn rows;"
      }
    },
