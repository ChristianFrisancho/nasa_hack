    {
      "id": "a2323c11-53bd-4198-a0b6-aeda3f1c3951",
      "name": "Extraer mapas de suelo y uso mayor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const text=s=>String(s||'').replace(/<[^>]+>/g,' ').replace(/&nbsp;/g,' ').replace(/&amp;/g,'&').replace(/\\s+/g,' ').trim();\nconst out=[];const seen=new Set();\nfor(const input of $input.all()){\n const html=input.json.data;\n if(typeof html!=='string'||!html.includes('<td'))throw new Error('SIAR: catalogo HTML no reconocido');\n const trs=html.match(/<tr\\b[^>]*>[\\s\\S]*?<\\/tr>/gi)||[];\n for(const tr of trs){\n  const td=[...tr.matchAll(/<td\\b[^>]*>([\\s\\S]*?)<\\/td>/gi)].map(x=>text(x[1]));\n  if(td.length<5)continue;\n  const title=td[3];if(!/suelos?|capacidad de uso|zonificaci[oó]n|fisiograf|geomorfol|pendiente/i.test(title))continue;\n  const m=tr.match(/href=['\\\"]([^'\\\"]+\\.pdf)['\\\"]/i);if(!m)continue;\n  let url=m[1];if(url.startsWith('../'))url='https://siar.regionpiura.gob.pe/'+url.slice(3);\n  if(!url.startsWith('https://siar.regionpiura.gob.pe/'))continue;\n  if(seen.has(url))continue;seen.add(url);\n  const date=td[0].match(/^(\\d{2})\\/(\\d{2})\\/(\\d{4})$/);const iso=date?date[3]+'-'+date[2]+'-'+date[1]:'';\n  out.push({json:{record_key:'siar-map:'+url,record_type:'catalogo_mapa_oficial',topic:'suelo_territorio',location_label:title,source_url:url,source_date:iso,retrieved_at:new Date().toISOString(),quality_status:'catalogo_historico_no_analitica_parcela',payload_json:JSON.stringify({title,institution:td[4],index_url:'https://siar.regionpiura.gob.pe/mapas',date_raw:td[0],pdf_content_extracted:false})}});\n }\n}\nif(!out.length)throw new Error('SIAR: no se encontraron mapas relevantes; revisar estructura');\nreturn out;"
      }
    },
